# Database configuration for notes backend
# If DATABASE_URL is not set, service defaults to sqlite:///notes.db in project root
# Examples:
# DATABASE_URL=sqlite:///notes.db
# DATABASE_URL=sqlite:////data/notes.db
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname

DATABASE_URL=
# Optional: Explicit path for SQLite file if DATABASE_URL is not provided.
NOTES_DB_PATH=notes.db
